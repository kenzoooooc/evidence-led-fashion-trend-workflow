{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategic fashion direction",
  "type": "object",
  "required": ["direction_id", "name", "signal_ids", "core_proposition", "rationale", "review_status"],
  "properties": {
    "direction_id": {"type": "string"},
    "name": {"type": "string"},
    "signal_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "target_mindset": {"type": "string"},
    "material_expression": {"type": "array", "items": {"type": "string"}},
    "core_proposition": {"type": "string"},
    "rationale": {"type": "string"},
    "review_status": {"enum": ["pending", "reviewed", "rejected"]}
  }
}
